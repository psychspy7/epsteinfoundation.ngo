# Server Configuration
PORT=3000
NODE_ENV=production

# Foundation Operational Guardrail
# Keep DONATIONS_ENABLED=false until Section 8 incorporation, bank account, and KYC are completed.
FOUNDATION_STATUS=PROPOSAL_STAGE
DONATIONS_ENABLED=false

# Razorpay Payment Gateway Credentials (Add after Section 8 incorporation & Razorpay NGO KYC)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Allowed origin for CORS (e.g., https://epsteinfoundation.ngo.ind.in)
ALLOWED_ORIGIN=*
